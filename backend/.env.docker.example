# Скопируйте в backend/.env для работы с docker-compose (PostgreSQL у контейнері → localhost:55432):
#   cp backend/.env.docker.example backend/.env

DATABASE_URL="postgresql://watta:watta@127.0.0.1:55432/watta_sushi?schema=public"
# На macOS порт 5000 часто зайнятий AirPlay — для локалки краще 5050
PORT=5050
JWT_SECRET="local-dev-jwt-secret-change-in-production-min-32-chars"

# Редіректи після оплати (локально)
FRONTEND_URL="http://localhost:3000"

# Оплата LiqPay — лише для тесту чекауту; без ключів кошик працює, оплата ні
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
