# Prisma в этом проекте настроен на PostgreSQL (см. prisma/schema.prisma).
#
# Якщо prisma / API дає P1010 «User watta was denied access»:
# на 5432 часто слухає НЕ Docker (watta/watta), а інший Postgres. Тоді або
#   npm run docker:db   (з кореня, потрібен Docker Desktop) → npm run local:prepare
# або змініть DATABASE_URL на свого користувача й створіть БД watta_sushi вручну.
#
# Швидкий стек як у docker-compose.yml: скопіюйте backend/.env.docker.example → backend/.env
# З docker-compose у цьому репо — порт 55432 на хості (див. docker-compose.yml).
DATABASE_URL="postgresql://watta:watta@127.0.0.1:55432/watta_sushi?schema=public"

# Должен совпадать с NEXT_PUBLIC_API_URL во фронте (web/.env.development). На macOS AirPlay часто занимает 5000 — по умолчанию 5050.

# Продакшен (Render): публичный URL фронта без слэша в конце.
# FRONTEND_URL=https://your-frontend.onrender.com

# Дополнительные Origin для CORS через запятую (кастомный домен, превью).
# CORS_ORIGINS=https://www.example.com,https://preview.onrender.com
PORT=5050

# Ліміт тіла JSON (адмінка: кілька base64-фото в одному запиті). За замовчуванням 50mb.
# JSON_BODY_LIMIT=100mb

JWT_SECRET="your-secret-key-here"
FRONTEND_URL="http://localhost:3000"

# Google OAuth (вхід / реєстрація через Google)
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# 2) Authorized JavaScript origins: http://localhost:3000, https://your-frontend.onrender.com
# 3) Authorized redirect URIs не потрібні для GIS (ID token flow)
# GOOGLE_OAUTH_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Render: Persistent Disk mount /var/data → UPLOAD_DIR=/var/data/uploads
# Перевірка після деплою: GET https://YOUR-API.onrender.com/health/storage
# UPLOAD_DIR=/var/data/uploads

# Stripe Checkout (рекомендовано для EUR / NL)
# 1) Dashboard → Developers → API keys → Secret key (sk_test_... або sk_live_...)
# STRIPE_SECRET_KEY=sk_test_...
# 2) Webhook — локально:
#    npm run stripe:setup   (якщо немає stripe в PATH)
#    ./.bin/stripe login    (один раз, відкриється браузер)
#    npm run stripe:listen  (скопіюйте whsec_... у STRIPE_WEBHOOK_SECRET)
#    Прод: Dashboard → Webhooks → https://YOUR-API.onrender.com/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# 1) LiqPay — https://www.liqpay.ua/ (альтернатива)

# Stripe Webhook: секрет подписи из Stripe Dashboard → Developers → Webhooks → [ваш endpoint] → Signing secret
# Для локальной разработки: stripe listen --forward-to localhost:5050/webhooks/stripe
#   (команда выведет whsec_... — скопируйте его сюда)
# Для продакшена: задайте публичный URL бэкенда в Stripe Dashboard как endpoint
# STRIPE_WEBHOOK_SECRET=whsec_...
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyBSwdK5Q061qWuINMWZLupxBfdcMxOwDx4
# Увімкніть у Google Cloud: Geocoding API + Distance Matrix API (білінг). Для NL /delivery/check — відстань по дорозі та час у дорозі (пробки).

# ─── Безпека доставки (staged deployment) ─────────────────────────────────────
#
# DELIVERY_STRICT_VERIFICATION — двофазний деплой для безпечного переходу:
#
#   Phase 1 (значення не задано, default):
#     CARD-замовлення: завжди вимагають підписаного токена (deliveryQuoteToken).
#     CASH-замовлення: приймають старий deliveryPrice від клієнта (зворотна сумісність).
#     → Деплой нового бекенду безпечний — старий фронтенд продовжує працювати.
#
#   Phase 2 (після підтвердження, що новий фронтенд повністю розгорнутий):
#     Встановіть DELIVERY_STRICT_VERIFICATION=1 у Render → Environment.
#     Усі замовлення (і CASH, і CARD) вимагають токена або deliveryZoneId.
#     Клієнтський deliveryPrice повністю ігнорується.
#
# Порядок деплою:
#   1. git push → Render запускає міграцію + новий бекенд (CASH fallback увімкнено)
#   2. Переконайтесь, що фронтенд задеплоєний (нова версія з deliveryQuoteToken)
#   3. Перевірте логи: відсутність "LEGACY CASH fallback used"
#   4. Встановіть DELIVERY_STRICT_VERIFICATION=1 → Render перезапустить сервер
#
# DELIVERY_STRICT_VERIFICATION=1

# Google Sheets — замовлення (перша вкладка) + база клієнтів CRM (вкладка «Клиенты»).
# 1) Google Cloud → Service Account → JSON ключ (client_email + private_key)
# 2) Створіть таблицю, надайте service account email доступ «Редактор»
# 3) GOOGLE_SHEET_ID — id з URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_CREDS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# На Render, якщо GOOGLE_CREDS зайнято — можна GOOGLE_CREDSS (те саме значення).
# GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_CRM_SHEET_TITLE=Клиенты

# DELIVERY_QUOTE_SECRET — секрет для HMAC-підпису токена вартості доставки.
# Якщо не задано — використовується JWT_SECRET (зворотна сумісність).
# У production рекомендується задати окремий секрет.
# DELIVERY_QUOTE_SECRET=your-delivery-quote-secret-min-32-chars

# ─── SMS (Twilio) — коды входа / подтверждение телефона ───────────────────────
# Console: https://console.twilio.com
# 1) Account SID + Auth Token (Dashboard)
# 2) Phone Numbers → купить номер (NL +31…) ИЛИ Messaging → Services → создать service
#    (Messaging Service удобнее для разных стран — один SID на все направления)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+31XXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MG...   (альтернатива TWILIO_PHONE_NUMBER)
# TWILIO_SEND_IN_DEV=1                 (опционально: слать реальные SMS локально)

# ─── Print Server (для термопринтера в ресторані) ────────────────────────────
# Токен для локального print-server, який опитує API та друкує чеки на
# термопринтері через USB/Tailscale.
# Згенеруйте будь-який складний рядок (наприклад, openssl rand -hex 32)
# і вкажіть такий самий у scripts/print-server/.env
# PRINT_SERVER_TOKEN=your-print-server-token-here
