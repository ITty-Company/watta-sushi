# Prisma в этом проекте настроен на PostgreSQL (см. prisma/schema.prisma).
#
# Якщо prisma / API дає P1010 «User watta was denied access»:
# на 5432 часто слухає НЕ Docker (watta/watta), а інший Postgres. Тоді або
#   npm run docker:db   (з кореня, потрібен Docker Desktop) → npm run local:prepare
# або змініть DATABASE_URL на свого користувача й створіть БД watta_sushi вручну.
#
# Швидкий стек як у docker-compose.yml: скопіюйте backend/.env.docker.example → backend/.env
# З docker-compose у цьому репо — порт 55432 на хості (див. docker-compose.yml).
DATABASE_URL="postgresql://watta:watta@127.0.0.1:55432/watta_sushi?schema=public"

# Должен совпадать с NEXT_PUBLIC_API_URL во фронте (web/.env.development). На macOS AirPlay часто занимает 5000 — по умолчанию 5050.
PORT=5050

JWT_SECRET="your-secret-key-here"
FRONTEND_URL="http://localhost:3000"

# Опціонально: без ключа сервер стартує; оплата CARD поверне 503 доти, доки не додасте ключ.
# STRIPE_SECRET_KEY=sk_test_...

# Повне локальне середовище з кореня репозиторію: npm run local:prepare (Docker) → npm run local:all
# Якщо Docker не запущений: SKIP_DOCKER=1 npm run local:prepare (потрібен свій DATABASE_URL, напр. Render).
