generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ПОЛЬЗОВАТЕЛИ ---
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique // Логин
  password String // Пароль
  phone    String  @unique // Уникальный телефон (защита от абуза)
  name     String?
  role     String  @default("USER")
  bonusBalance Float @default(0)

  // Статусы верификации
  isPhoneVerified  Boolean @default(false) // Главный флаг подтверждения
  verificationCode String? // Сюда пишем код из SMS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  orders         Order[]
  promoUsages    UserPromoUsage[]
  personalPromos PersonalPromo[]

  dateOfBirth DateTime?
  favorites       Favorite[]
  reviews         OrderReview[]
  notifications   UserNotification[]
}

// --- ТОВАРЫ ---
model Category {
  id       Int       @id @default(autoincrement())
  name_ru  String
  name_en  String?
  name_ua  String?
  name_nl  String?
  slug     String    @unique
  emoji    String?   @default("🍣") // Эмодзи для категории
  order    Int       @default(0) // Порядок отображения
  isActive Boolean   @default(true) // Активна ли категория
  /// Якщо false — товари з цієї категорії не в «хітах» на головній і не в рекомендаціях кошика
  allowRecommendations Boolean @default(true)
  products Product[]
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Название страны (например, "Нидерланды")
  name_ua   String? // Украинское название
  name_en   String? // Английское название
  name_nl   String? // Нидерландское название
  flag      String? // Эмодзи флага (например, "🇳🇱")
  code      String   @unique // Код страны (например, "NL")
  isActive  Boolean  @default(true)
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id            Int            @id @default(autoincrement())
  name          String
  name_ua       String? // Українська назва
  name_nl       String? // Нидерландское название
  name_en       String? // Английское название
  pricePerKm    Float          @default(10)
  countryId     Int
  country       Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  latitude      Float? // Широта для карты
  longitude     Float? // Долгота для карты
  /// Точка кухні / ресторану для розрахунку €/км (якщо null — беруться latitude/longitude міста)
  restaurantLatitude  Float?
  restaurantLongitude Float?
  zoom          Int            @default(12) // Уровень зума карты
  isActive      Boolean        @default(true)
  products      ProductCity[]
  deliveryZones DeliveryZone[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([name, countryId])
}

model DeliveryZone {
  id          Int      @id @default(autoincrement())
  name        String // Название зоны (например, "Центр")
  color       String   @default("#145142") // Цвет зоны на карте
  cityId      Int
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  coordinates String // JSON строка с координатами полигона [{lat, lng}, ...]
  /// Безкоштовна доставка в межах цієї зони
  isFreeDelivery Boolean @default(false)
  /// Фіксована вартість доставки (€); якщо null і не isFreeDelivery — діє база сайту + €/км міста
  flatDeliveryFee Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  // Названия
  name_ru String
  name_ua String? @default("")
  name_en String? @default("")
  name_nl String? @default("")

  // Описания
  description_ru String?
  description_ua String? @default("")
  description_en String? @default("")
  description_nl String? @default("")

  price     Float
  imageUrl  String?
  /// Галерея фото (порядок = порядок у каруселі); перше = обкладинка в меню
  imageUrls Json     @default("[]")
  isPopular Boolean @default(false)
  /// Бейдж «Новинка» + блок «Новинки» на сторінці /menu (окремо від хітів)
  isMenuNew   Boolean @default(false)
  /// «Наші хіти» — стрічка на головній, сортування в каталозі, бейдж (окремо від кошика)
  isHomeHit   Boolean @default(false)
  /// Рекомендації після додавання в кошик (GET /api/products/recommendations)
  isCartRecommend     Boolean @default(false)
  /// Порядок у блоці «хіти» на головній (менше — раніше)
  recommendOrder      Int     @default(0)
  /// Порядок у рекомендаціях кошика
  cartRecommendOrder    Int     @default(0)
  /// Акційна знижка у % (0 = без акції); ціна зі знижкою рахується на клієнті
  promoDiscountPercent Int     @default(0)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  cities     ProductCity[]
  orderItems OrderItem[]
  favorites  Favorite[]

  ingredients Ingredient[]
  cartUpsellTierProducts CartUpsellTierProduct[]
}

/// Пороги суми замовлення → фіксована знижка € на обрані товари в кошику
model CartUpsellTier {
  id            Int      @id @default(autoincrement())
  minOrderTotal Float
  maxOrderTotal Float?
  discountEur   Float
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  products      CartUpsellTierProduct[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartUpsellTierProduct {
  id        Int            @id @default(autoincrement())
  tierId    Int
  tier      CartUpsellTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  productId Int
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  @@unique([tierId, productId])
}

model ProductCity {
  id        Int     @id @default(autoincrement())
  productId Int
  cityId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  city      City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([productId, cityId])
}

// --- ЗАКАЗЫ ---
model Order {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  status     String   @default("PENDING") // PENDING, CONFIRMED, DELIVERED, CANCELLED
  totalPrice Float
  usedBonuses Float   @default(0)

  customerName  String  @default("Гость")
  phone         String  @default("")
  address       String  @default("")
  fulfillmentType String @default("DELIVERY") // DELIVERY | PICKUP
  deliveryFee   Float   @default(0) // UAH charged for delivery on this order (0 if free or pickup)
  paymentMethod String  @default("CASH")
  paymentStatus PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String?
  paidAt       DateTime?
  comment       String?

  noCallbackConfirm Boolean @default(false) // не перезванивать для подтверждения
  noDoorbellRing    Boolean @default(false) // не звонить в дверь

  /// Згода на обробку персональних даних при оформленні замовлення
  dataProcessingConsentAt DateTime?

  // Связь с пользователем (опционально, так как заказ может сделать гость)
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  items OrderItem[]
  review OrderReview?
}

/// Відгук клієнта після отримання замовлення (1 відгук на замовлення)
model OrderReview {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  userId    Int
  rating    Int
  text      String
  images    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// Сповіщення клієнта (статус замовлення тощо)
model UserNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("ORDER_STATUS") // ORDER_STATUS | ...
  title     String
  body      String
  orderId   Int?
  meta      Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([orderId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

// --- БАННЕРЫ ---
model Banner {
  id        Int      @id @default(autoincrement())
  title_ru  String // Заголовок на русском
  title_ua  String? // Заголовок на украинском
  title_en  String? // Заголовок на английском
  title_nl  String? // Заголовок на нидерландском
  imageUrl  String // URL изображения баннера
  /// Фокус кадра для background-size: cover (в процентах, 0..100)
  focalX   Float    @default(50)
  focalY   Float    @default(50)
  order     Int      @default(0) // Порядок отображения
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id             Int @id @default(1) // Всегда ID=1 (синглтон)
  bannerInterval Int @default(5000) // Интервал в миллисекундах (по умолчанию 5 сек)

  /// Головна: перше hero-відео (зворотна сумісність; дублює [0] з homeHeroVideoUrls)
  homeHeroVideoUrl String @default("/watta-sushi-2-hero.mp4")
  /// JSON-масив до 3 шляхів (/uploads/… або /…mp4) — порядок відтворення на головній
  homeHeroVideoUrls String @default("[]")

  /// Доставка: перше hero-відео (зворотна сумісність; дублює [0] з deliveryHeroVideoUrls)
  deliveryHeroVideoUrl String @default("/watta-sushi-2-hero.mp4")
  /// JSON-масив шляхів — порядок відтворення на сторінці доставки
  deliveryHeroVideoUrls String @default("[]")

  /// Вхід / реєстрація: перше відео в симуляторі телефона (зворотна сумісність; дублює [0] з authHeroVideoUrls)
  authHeroVideoUrl String @default("/watta-sushi-2-hero.mp4")
  /// JSON-масив шляхів — плейлист у передньому «телефоні» на /login та /register
  authHeroVideoUrls String @default("[]")
  /// JSON-масив — плейлист у другому (задньому) телефоні на сторінці входу
  authHeroPhone2VideoUrls String @default("[]")
  /// JSON: { uk, ru, en, nl } → { title, subtitle, benefits[3] } для першого телефона
  authHeroPhone1Copy String @default("{}")
  /// JSON: те саме для другого телефона
  authHeroPhone2Copy String @default("{}")

  telegramUrl             String @default("")
  whatsappUrl             String @default("")
  instagramUrl            String @default("")
  restaurantPickupAddress String @default("")
  freeDeliveryThreshold   Float  @default(1000) // merchandise total >= this => free delivery
  deliveryFee             Float  @default(50) // fixed fee if below threshold

  /// Адреса кухні (відправлення) для розрахунку доставки по NL; геокодується при збереженні в адмінці
  deliveryKitchenAddress String @default("Helicopterstraat 20, 1059 CG Amsterdam, Netherlands")
  deliveryKitchenLat     Float?
  deliveryKitchenLng     Float?
  /// Кожні N км додається один «крок» тарифу (округлення вгору по відстані)
  deliveryTariffStepKm   Float @default(3)
  /// Вартість одного кроку, €
  deliveryTariffStepEur  Float @default(1.5)
}

// --- КОМАНДА ---
model TeamMember {
  id          Int      @id @default(autoincrement())
  name_ru     String // Имя на русском
  name_ua     String? // Имя на украинском
  name_en     String? // Имя на английском
  name_nl     String? // Имя на нидерландском
  position_ru String // Должность на русском
  position_ua String? // Должность на украинском
  position_en String? // Должность на английском
  position_nl String? // Должность на нидерландском
  imageUrl    String? // URL фото сотрудника
  bio_ru      String? // Биография на русском
  bio_ua      String? // Биография на украинском
  bio_en      String? // Биография на английском
  bio_nl      String? // Биография на нидерландском
  order       Int      @default(0) // Порядок отображения
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Promo {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String? // Полный текст
  imageUrl    String?
  /// Галерея фото (URL-и), перше часто використовується як обкладинка
  galleryUrls Json     @default("[]")
  /// Акційні позиції: [{ "productId": 1, "discountPercent": 15 }, ...]
  productOffers Json   @default("[]")
  isHit       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  videoUrl    String?
  author      String   @default("Шеф Watta Sushi")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Типы промокодов
enum PromoType {
  WELCOME // Стартовый
  BIRTHDAY // ДР
  REACTIVATION // Возвращение клиента
  GENERAL // Обычный (реклама)
}

model PromoCode {
  id          Int     @id @default(autoincrement())
  code        String  @unique // Сам код, например "WATTASUSHI" или "BDAY2025"
  description String
  discount    Int // Процент или сумма
  isFixed     Boolean @default(false) // false = %, true = грн
  minOrder    Int     @default(0)

  type     PromoType
  isActive Boolean   @default(true)

  usages UserPromoUsage[]
}

// Таблица выданных личных промокодов (генерируем уникальные)
model PersonalPromo {
  id        Int       @id @default(autoincrement())
  code      String    @unique // Уникальный код, например "START-8492"
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  type      PromoType
  discount  Int
  expiresAt DateTime
  isUsed    Boolean   @default(false)

  createdAt DateTime @default(now())
}

// История использования (чтобы не юзали дважды)
model UserPromoUsage {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Ссылка либо на общий промокод, либо на личный (можно упростить логику)
  promoCodeId Int?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  personalPromoId Int? // Если использовали личный код

  usedAt DateTime @default(now())
}

model Favorite {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, productId]) // Составной ключ: один юзер не может дважды лайкнуть один товар
}


enum PaymentMethod {
  CASH
  CARD        // Обычный ввод карты
  APPLE_PAY
  GOOGLE_PAY
  IDEAL       // Для Голландии это мастхэв, добавим на будущее
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}


model Ingredient {
  id        Int     @id @default(autoincrement())
  name_ru   String
  name_ua   String?
  name_en   String?
  name_nl   String?
  imageUrl  String  // Ссылка на фото ингредиента (лосось, рис и т.д.)
  
  products  Product[]
}