{
  "name": "sushi-icon",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "export NODE_ENV=development && export DOTENV_CONFIG_QUIET=1 && prisma generate && prisma migrate deploy && tsx watch server.js",
    "dev:quick": "export NODE_ENV=development && export DOTENV_CONFIG_QUIET=1 && prisma generate && tsx watch server.js",
    "start": "npm run init-db && npx tsx server.js",
    "start:single": "npm run init-db && npx tsx server.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "seed": "npx prisma db seed",
    "init-db": "npx tsx scripts/init-db.js",
    "seed:countries": "npx tsx scripts/seed-countries.ts",
    "setup:local": "prisma migrate deploy && prisma db seed",
    "compress:ingredients": "node scripts/compress-ingredient-images.js",
    "compress:products": "node scripts/compress-product-images.js",
    "compress:hero-uploads": "node scripts/compress-hero-uploads.js",
    "cache:clear": "node ../scripts/clear-all-caches.cjs",
    "local": "npm run local --prefix ..",
    "stripe:login": "node scripts/stripe-cli.cjs login",
    "stripe:listen": "node scripts/stripe-cli.cjs listen --forward-to localhost:5050/webhooks/stripe",
    "stripe:setup": "node scripts/install-stripe-cli.cjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm install && (cd frontend && npm install && npm run build)"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.78.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.5.0",
    "google-spreadsheet": "^5.0.2",
    "googleapis": "^164.1.0",
    "helmet": "^8.1.0",
    "i18n-telegraf": "^8.6.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.11.0",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "telegraf": "^4.16.3",
    "telegraf-session-local": "^2.1.1",
    "twilio": "^5.10.1",
    "ua-parser-js": "^2.0.5",
    "vite": "^7.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.js"
  }
}
