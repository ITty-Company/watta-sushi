# ── Якщо в терміналі Next: «ECONNREFUSED 127.0.0.1:5050» / Failed to proxy …5050 ──
# Це означає: локальний Express (backend) на порту 5050 НЕ запущений, а фронт намагається проксувати /api туди.
# Варіанти:
#   1) Запустити API: з кореня `npm run local:backend:quick` або `cd backend && npm run dev:quick` (потрібна БД + backend/.env)
#   2) Тільки фронт без бекенда: з кореня `npm run local:web:mock` або з папки web `npm run dev:mock`
#      (USE_LOCAL_MOCK=1 — без проксі на 5050, дані з middleware / моків)

# Локальна робота (адмінка, банери, меню): з кореня репо
#   npm run local:all
# Скрипт local:web примусово ставить NEXT_PUBLIC_API_URL=http://127.0.0.1:5050 (вище за .env*.local),
# щоб проксі Next завжди йшов у локальний Express, навіть якщо в .env.development.local залишився URL Render.
#
# НЕ плутати з npm run local:web:render — там тільки Next, API з .env.render.local / Render.

# Телефон у Wi‑Fi: npm run dev:lan у папці web і вручну NEXT_PUBLIC_API_URL=http://<IP_ПК>:5050
# На Mac для проксі краще 127.0.0.1, не localhost (IPv6).

NEXT_PUBLIC_API_URL=http://127.0.0.1:5050

# Google OAuth — той самий Client ID, що GOOGLE_OAUTH_CLIENT_ID у backend/.env
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Опційно: вимкнути сплеш «Завантаження» на головній (за замовчуванням увімкнено на F5 і перший візит).
# Boot splash на головній при F5 (на проді увімкнено за замовчуванням). Вимкнути:
# NEXT_PUBLIC_WATTA_BOOT_SPLASH=0

# Ключ Google для геокодування кухні та /api/delivery/check НЕ сюди — у backend/.env як
# GOOGLE_MAPS_SERVER_API_KEY (див. backend/.env.example). Тут лише фронт (наприклад Distance Matrix у кошику):
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Звідки рахується відстань доставки до адреси клієнта (км × pricePerKm міста з адмінки).
# За замовчуванням у коді: Amstelveenseweg 192, 1075 XR Amsterdam
# NEXT_PUBLIC_DELIVERY_ORIGIN_ADDRESS=Amstelveenseweg 192, 1075 XR Amsterdam

# Дані з Render (без локального backend): npm run dev:render у web — див. web/.env.render.example

# Meta Pixel ID (Events Manager → Data sources → Pixel → ID).
# Якщо не задано — піксель не ініціалізується (немає зайвих запитів у dev).
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
