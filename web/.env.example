# Локальна робота (адмінка, банери, меню): з кореня репо
#   npm run local:all
# Скрипт local:web примусово ставить NEXT_PUBLIC_API_URL=http://127.0.0.1:5050 (вище за .env*.local),
# щоб проксі Next завжди йшов у локальний Express, навіть якщо в .env.development.local залишився URL Render.
#
# НЕ плутати з npm run local:web:render — там тільки Next, API з .env.render.local / Render.

# Телефон у Wi‑Fi: npm run dev:lan у папці web і вручну NEXT_PUBLIC_API_URL=http://<IP_ПК>:5050
# На Mac для проксі краще 127.0.0.1, не localhost (IPv6).

NEXT_PUBLIC_API_URL=http://127.0.0.1:5050

# Звідки рахується відстань доставки до адреси клієнта (км × pricePerKm міста з адмінки).
# За замовчуванням у коді: Amstelveenseweg 192, 1075 XR Amsterdam
# NEXT_PUBLIC_DELIVERY_ORIGIN_ADDRESS=Amstelveenseweg 192, 1075 XR Amsterdam

# Дані з Render (без локального backend): npm run dev:render у web — див. web/.env.render.example
