# ─── API (бекенд Watta Sushi) ─────────────────────────────────────────────
# Публічний URL вашого API (Render)
API_URL=https://watta-sushi-backend.onrender.com

# Токен, який ви задали на сервері (PRINT_SERVER_TOKEN у backend/.env або Render secrets)
PRINT_SERVER_TOKEN=your-print-server-token-here

# ─── Інтервал опитування (секунди) ──────────────────────────────────────
POLL_INTERVAL_SEC=5

# ─── Принтер ──────────────────────────────────────────────────────────────
# Тип принтера: EPSON, STAR, CUSTOM
PRINTER_TYPE=EPSON

# Інтерфейс підключення:
#   USB:   usb (автовизначення)
#   TCP:   tcp://192.168.1.100:9100
#   Serial: serial:/dev/usb/lp0
PRINTER_INTERFACE=usb

# Ширина паперу (mm). 58mm або 80mm
PRINTER_WIDTH_MM=58

# Кодування (CP866 для кирилиці на EPSON)
PRINTER_CHARACTER_SET=CP866
